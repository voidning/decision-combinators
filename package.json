{
  "name": "jev-combinators",
  "version": "0.1.0",
  "description": "Composable decision circuits for Jev and other judgment primitives",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "keywords": [
    "jev",
    "decision",
    "combinators",
    "agent",
    "ai",
    "decision-programming"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsx examples/triage.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@typesafe-ai/sdk": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@typesafe-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}